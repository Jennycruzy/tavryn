# Copy to backend/.env (LocalNet) or backend/.env.devnet (run with TAVRYN_ENV_FILE=.env.devnet).
# Never commit either file. Values must come from the participant/network setup.

# Ledger connection
CANTON_LEDGER_API_URL=
CANTON_USER_ID=
CANTON_PARTICIPANT_ID=
CANTON_SYNCHRONIZER_ID=
CANTON_PACKAGE_ID=
# Either a static token (LocalNet) ...
CANTON_LEDGER_API_TOKEN=
# ... or OIDC, which is refreshed automatically (shared DevNet nodes). Give a refresh
# token, or a username and password, or a client secret.
CANTON_OIDC_TOKEN_URL=
CANTON_OIDC_CLIENT_ID=
CANTON_OIDC_CLIENT_SECRET=
CANTON_OIDC_REFRESH_TOKEN=
CANTON_OIDC_USERNAME=
CANTON_OIDC_PASSWORD=
CANTON_OIDC_AUDIENCE=
CANTON_OIDC_SCOPE=

# Parties (one ledger user with actAs on all of them)
SUPPLIER_PARTY_ID=
BUYER_PARTY_ID=
AUDITOR_PARTY_ID=
# role:party pairs. Falls back to FINANCIER_A/B_PARTY_ID and
# GOVERNANCE_CANDIDATE_PARTY_ID (as financierC) when unset.
TAVRYN_FINANCIERS=
FINANCIER_A_PARTY_ID=
FINANCIER_B_PARTY_ID=
GOVERNANCE_CANDIDATE_PARTY_ID=

# Governance: distinct operator parties and how many must agree
TAVRYN_NETWORK_ID=tavryn
GOVERNANCE_OPERATOR_ONE_PARTY_ID=
GOVERNANCE_OPERATOR_TWO_PARTY_ID=
GOVERNANCE_OPERATOR_THREE_PARTY_ID=
GOVERNANCE_THRESHOLD=2
# Used only when `npm run bootstrap` first creates the network
TAVRYN_INITIAL_FINANCIERS=financierA,financierB
TAVRYN_INITIAL_MAX_ADVANCE_RATE=0.95

# Canton Coin settlement (invoices must be denominated in CANTON_COIN_SYMBOL)
CANTON_COIN_SYMBOL=
CANTON_VALIDATOR_API_URL=
CANTON_WALLET_TOKEN_BUYER=
CANTON_WALLET_TOKEN_FINANCIER_A=
CANTON_WALLET_TOKEN_FINANCIER_B=
CANTON_TRANSFER_EXPIRY_SECONDS=300

# Tavryn backend
TAVRYN_HTTP_PORT=
# Optional public-demo protection. If set, sign in at POST /api/v1/session
# with TAVRYN_DEMO_PASSPHRASE (or the token itself when no passphrase is set).
TAVRYN_DEMO_ACCESS_TOKEN=
TAVRYN_DEMO_PASSPHRASE=
TAVRYN_WRITE_RATE_LIMIT=30
