module Tavryn.Contracts where

import DA.Crypto.Text (sha256, toHex)
import DA.List (unique)
import qualified DA.Text as T

import Tavryn.Rules
import Tavryn.Types

-- | The commitment is computed on the ledger from the parties, the terms and a private
-- salt, so a supplier cannot attach a commitment that does not match the invoice.
invoiceCommitmentFor : Party -> Party -> InvoiceTerms -> Text -> Text
invoiceCommitmentFor supplier buyer terms salt =
  sha256 (toHex (show (supplier, buyer, terms, salt)))

template InvoiceDraft
  with
    supplier : Party
    buyer : Party
    terms : InvoiceTerms
    salt : Text
  where
    ensure validTerms terms && T.length salt >= 16
    signatory supplier
    observer buyer

    choice Approve : ContractId ApprovedInvoice
      with
        rulesCid : ContractId NetworkRules
        registryCid : ContractId BuyerApprovalRegistry
        eligibleFinanciers : [Party]
        auditor : Party
      controller buyer
      do
        rules <- fetch rulesCid
        registry <- fetch registryCid
        assertMsg "TAVRYN_REGISTRY_MISMATCH"
          (registry.buyer == buyer
            && registry.networkId == rules.networkId
            && registry.operators == rules.operators)
        assertMsg "TAVRYN_BUYER_NOT_ONBOARDED" (buyer `elem` rules.buyers)
        assertMsg "TAVRYN_NO_FINANCIERS"
          (not (null eligibleFinanciers) && unique eligibleFinanciers)
        assertMsg "TAVRYN_NOT_ELIGIBLE" (all (`elem` rules.financiers) eligibleFinanciers)
        _ <- exercise registryCid RecordApproval with
          externalInvoiceNumber = terms.externalInvoiceNumber
        let invoiceCommitment = invoiceCommitmentFor supplier buyer terms salt
        invoiceDetails <- create InvoiceDetails with
          buyer
          supplier
          auditor
          invoiceCommitment
          terms
          salt
        fundingSlot <- create FundingSlot with
          supplier
          buyer
          invoiceCommitment
          eligibleFinanciers
        create ApprovedInvoice with
          supplier
          buyer
          invoiceCommitment
          invoiceDetails
          fundingSlot
          eligibleFinanciers
          auditor
          networkId = rules.networkId
          operators = rules.operators

-- | Private invoice terms. Archived when the invoice is funded; the financed invoice
-- carries the terms from then on.
template InvoiceDetails
  with
    buyer : Party
    supplier : Party
    auditor : Party
    invoiceCommitment : Text
    terms : InvoiceTerms
    salt : Text
  where
    ensure invoiceCommitment /= "" && validTerms terms
    signatory buyer, supplier
    observer auditor

template FundingSlot
  with
    supplier : Party
    buyer : Party
    invoiceCommitment : Text
    eligibleFinanciers : [Party]
  where
    ensure invoiceCommitment /= "" && not (null eligibleFinanciers)
    signatory buyer, supplier
    observer eligibleFinanciers

    -- Terms-free. Its only purpose is to make concurrent funding attempts contend for
    -- one consumable ledger object without disclosing invoice data.
    choice Claim : ()
      with
        claimant : Party
      controller claimant
      do
        assertMsg "TAVRYN_NOT_ELIGIBLE" (claimant `elem` eligibleFinanciers)
        pure ()

template ApprovedInvoice
  with
    supplier : Party
    buyer : Party
    invoiceCommitment : Text
    invoiceDetails : ContractId InvoiceDetails
    fundingSlot : ContractId FundingSlot
    eligibleFinanciers : [Party]
    auditor : Party
    networkId : Text
    operators : [Party]
  where
    ensure invoiceCommitment /= "" && not (null eligibleFinanciers)
    signatory buyer, supplier
    observer eligibleFinanciers

    -- The supplier can issue several private offers for the same approved invoice.
    -- Offers store the commitment, not this contract ID, so they survive a cancelled
    -- funding attempt and every governance change.
    nonconsuming choice CreateOffer : ContractId FinancingOffer
      with
        rulesCid : ContractId NetworkRules
        financier : Party
        advance : Decimal
        advanceRate : Decimal
      controller buyer, supplier
      do
        rules <- fetch rulesCid
        assertRulesFor networkId operators rules
        assertMsg "TAVRYN_NOT_ELIGIBLE"
          (financier `elem` eligibleFinanciers && financier `elem` rules.financiers)
        assertMsg "TAVRYN_RATE_ABOVE_MAX"
          (validRate advanceRate && advanceRate <= rules.maxAdvanceRate)
        details <- fetch invoiceDetails
        assertMsg "TAVRYN_INVALID_ADVANCE"
          (advance > 0.0 && advance <= details.terms.faceValue * advanceRate)
        create FinancingOffer with
          supplier
          buyer
          financier
          invoiceCommitment
          terms = details.terms
          networkId
          operators
          advance
          advanceRate

template FinancingOffer
  with
    supplier : Party
    buyer : Party
    financier : Party
    invoiceCommitment : Text
    terms : InvoiceTerms
    networkId : Text
    operators : [Party]
    advance : Decimal
    advanceRate : Decimal
  where
    ensure invoiceCommitment /= ""
      && advance > 0.0 && advance <= terms.faceValue
      && validRate advanceRate
    signatory buyer, supplier
    observer financier

    -- Off-ledger settlement: the cash moved outside Canton, and the payment reference
    -- is recorded with an OFF_LEDGER instrument.
    choice Accept : ContractId FinancedInvoice
      with
        approvedInvoiceCid : ContractId ApprovedInvoice
        rulesCid : ContractId NetworkRules
        paymentReference : Text
      controller buyer, supplier, financier
      do
        assertMsg "TAVRYN_PAYMENT_REFERENCE_REQUIRED" (paymentReference /= "")
        approved <- lockForFunding this approvedInvoiceCid rulesCid
        archive approved.invoiceDetails
        financedCid <- create (financedFrom this approved.auditor)
        _ <- create FundingReceipt with
          buyer
          supplier
          financier
          auditor = approved.auditor
          financedInvoice = financedCid
          invoiceCommitment
          settlementAmount = advance
          instrument = "OFF_LEDGER"
          trackingId = ""
          paymentReference
        pure financedCid

    -- Two-step Canton Coin settlement: lock the invoice on the ledger first, then move
    -- the cash with the same tracking ID, then complete or cancel the lock.
    choice BeginFunding : ContractId PendingFunding
      with
        approvedInvoiceCid : ContractId ApprovedInvoice
        rulesCid : ContractId NetworkRules
        trackingId : Text
        settlementAmount : Decimal
        instrument : Text
      controller buyer, supplier, financier
      do
        assertMsg "TAVRYN_TRACKING_ID_REQUIRED" (trackingId /= "")
        assertMsg "TAVRYN_AMOUNT_MISMATCH" (settlementAmount == advance)
        assertMsg "TAVRYN_INSTRUMENT_MISMATCH" (instrument == terms.currency)
        approved <- lockForFunding this approvedInvoiceCid rulesCid
        lockedAt <- getTime
        create PendingFunding with
          buyer
          supplier
          financier
          auditor = approved.auditor
          invoiceCommitment
          invoiceDetails = approved.invoiceDetails
          eligibleFinanciers = approved.eligibleFinanciers
          networkId
          operators
          terms
          advance
          advanceRate
          trackingId
          settlementAmount
          instrument
          lockedAt

    -- Closing a losing offer leaves the financier a ledger fact that the invoice is
    -- gone, with no winner, amount or terms.
    choice Withdraw : ContractId OfferClosed
      controller supplier
      do
        create OfferClosed with buyer; supplier; financier; invoiceCommitment

-- | Consumes both the terms-free slot and the approved invoice. Whichever financier's
-- transaction commits first wins; any later attempt fails because both are gone.
lockForFunding
  : FinancingOffer -> ContractId ApprovedInvoice -> ContractId NetworkRules
  -> Update ApprovedInvoice
lockForFunding offer approvedInvoiceCid rulesCid = do
  approved <- fetch approvedInvoiceCid
  assertMsg "TAVRYN_INVOICE_MISMATCH"
    (approved.invoiceCommitment == offer.invoiceCommitment
      && approved.buyer == offer.buyer
      && approved.supplier == offer.supplier
      && approved.networkId == offer.networkId
      && approved.operators == offer.operators)
  rules <- fetch rulesCid
  assertRulesFor approved.networkId approved.operators rules
  assertMsg "TAVRYN_NOT_ELIGIBLE"
    (offer.financier `elem` approved.eligibleFinanciers
      && offer.financier `elem` rules.financiers)
  assertMsg "TAVRYN_RATE_ABOVE_MAX" (offer.advanceRate <= rules.maxAdvanceRate)
  exercise approved.fundingSlot Claim with claimant = offer.financier
  archive approvedInvoiceCid
  pure approved

financedFrom : FinancingOffer -> Party -> FinancedInvoice
financedFrom offer auditor = FinancedInvoice with
  buyer = offer.buyer
  supplier = offer.supplier
  financier = offer.financier
  auditor
  invoiceCommitment = offer.invoiceCommitment
  terms = offer.terms
  advance = offer.advance
  advanceRate = offer.advanceRate

template OfferClosed
  with
    buyer : Party
    supplier : Party
    financier : Party
    invoiceCommitment : Text
  where
    signatory buyer, supplier
    observer financier

template PendingFunding
  with
    buyer : Party
    supplier : Party
    financier : Party
    auditor : Party
    invoiceCommitment : Text
    invoiceDetails : ContractId InvoiceDetails
    eligibleFinanciers : [Party]
    networkId : Text
    operators : [Party]
    terms : InvoiceTerms
    advance : Decimal
    advanceRate : Decimal
    trackingId : Text
    settlementAmount : Decimal
    instrument : Text
    lockedAt : Time
  where
    ensure invoiceCommitment /= "" && trackingId /= "" && settlementAmount > 0.0
    signatory buyer, supplier, financier
    observer auditor

    choice Complete : ContractId FinancedInvoice
      with
        paymentReference : Text
      controller buyer, supplier, financier
      do
        assertMsg "TAVRYN_PAYMENT_REFERENCE_REQUIRED" (paymentReference /= "")
        archive invoiceDetails
        financedCid <- create FinancedInvoice with
          buyer
          supplier
          financier
          auditor
          invoiceCommitment
          terms
          advance
          advanceRate
        _ <- create FundingReceipt with
          buyer
          supplier
          financier
          auditor
          financedInvoice = financedCid
          invoiceCommitment
          settlementAmount
          instrument
          trackingId
          paymentReference
        pure financedCid

    -- Restores the approved invoice, a fresh slot and this financier's offer. The
    -- locking financier is a controller, so buyer and supplier cannot reopen funding
    -- behind the back of a financier whose cash may already have moved.
    choice Cancel : ContractId ApprovedInvoice
      controller buyer, supplier, financier
      do
        fundingSlot <- create FundingSlot with
          supplier
          buyer
          invoiceCommitment
          eligibleFinanciers
        _ <- create FinancingOffer with
          supplier
          buyer
          financier
          invoiceCommitment
          terms
          networkId
          operators
          advance
          advanceRate
        create ApprovedInvoice with
          supplier
          buyer
          invoiceCommitment
          invoiceDetails
          fundingSlot
          eligibleFinanciers
          auditor
          networkId
          operators

template FundingReceipt
  with
    buyer : Party
    supplier : Party
    financier : Party
    auditor : Party
    financedInvoice : ContractId FinancedInvoice
    invoiceCommitment : Text
    settlementAmount : Decimal
    instrument : Text
    trackingId : Text
    paymentReference : Text
  where
    ensure invoiceCommitment /= "" && paymentReference /= "" && settlementAmount > 0.0
    signatory buyer, supplier, financier
    observer auditor

template FinancedInvoice
  with
    buyer : Party
    supplier : Party
    financier : Party
    auditor : Party
    invoiceCommitment : Text
    terms : InvoiceTerms
    advance : Decimal
    advanceRate : Decimal
  where
    ensure invoiceCommitment /= ""
      && advance > 0.0 && advance <= terms.faceValue
      && validRate advanceRate
    signatory buyer, supplier, financier
    observer auditor

    -- Off-ledger repayment with an external payment reference.
    choice Repay : ContractId RepaymentReceipt
      with
        repaymentDate : Date
        paymentReference : Text
      controller buyer, financier
      do
        assertMsg "TAVRYN_REPAYMENT_BEFORE_ISSUE" (repaymentDate >= terms.issuedDate)
        assertMsg "TAVRYN_PAYMENT_REFERENCE_REQUIRED" (paymentReference /= "")
        create RepaymentReceipt with
          buyer
          financier
          auditor
          invoiceCommitment
          repaymentDate
          early = repaymentDate < terms.dueDate
          amount = terms.faceValue
          instrument = "OFF_LEDGER"
          trackingId = ""
          paymentReference

    choice BeginRepayment : ContractId PendingRepayment
      with
        repaymentDate : Date
        trackingId : Text
        settlementAmount : Decimal
        instrument : Text
      controller buyer, financier
      do
        assertMsg "TAVRYN_REPAYMENT_BEFORE_ISSUE" (repaymentDate >= terms.issuedDate)
        assertMsg "TAVRYN_TRACKING_ID_REQUIRED" (trackingId /= "")
        assertMsg "TAVRYN_AMOUNT_MISMATCH" (settlementAmount == terms.faceValue)
        assertMsg "TAVRYN_INSTRUMENT_MISMATCH" (instrument == terms.currency)
        lockedAt <- getTime
        create PendingRepayment with
          buyer
          supplier
          financier
          auditor
          invoiceCommitment
          terms
          advance
          advanceRate
          repaymentDate
          trackingId
          settlementAmount
          instrument
          lockedAt

template PendingRepayment
  with
    buyer : Party
    supplier : Party
    financier : Party
    auditor : Party
    invoiceCommitment : Text
    terms : InvoiceTerms
    advance : Decimal
    advanceRate : Decimal
    repaymentDate : Date
    trackingId : Text
    settlementAmount : Decimal
    instrument : Text
    lockedAt : Time
  where
    ensure invoiceCommitment /= "" && trackingId /= "" && settlementAmount > 0.0
    signatory buyer, supplier, financier
    observer auditor

    choice CompleteRepayment : ContractId RepaymentReceipt
      with
        paymentReference : Text
      controller buyer, financier
      do
        assertMsg "TAVRYN_PAYMENT_REFERENCE_REQUIRED" (paymentReference /= "")
        create RepaymentReceipt with
          buyer
          financier
          auditor
          invoiceCommitment
          repaymentDate
          early = repaymentDate < terms.dueDate
          amount = settlementAmount
          instrument
          trackingId
          paymentReference

    choice CancelRepayment : ContractId FinancedInvoice
      controller buyer, financier
      do
        create FinancedInvoice with
          buyer
          supplier
          financier
          auditor
          invoiceCommitment
          terms
          advance
          advanceRate

template RepaymentReceipt
  with
    buyer : Party
    financier : Party
    auditor : Party
    invoiceCommitment : Text
    repaymentDate : Date
    early : Bool
    amount : Decimal
    instrument : Text
    trackingId : Text
    paymentReference : Text
  where
    ensure invoiceCommitment /= "" && paymentReference /= "" && amount > 0.0
    signatory buyer, financier
    observer auditor
