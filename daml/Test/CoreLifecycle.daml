module Test.CoreLifecycle where

import DA.Date (Month(..), date)
import DA.Time (time)
import Daml.Script

import Tavryn.Contracts
import Tavryn.Governance
import Tavryn.Rules
import Tavryn.Types
import Test.Support

testCoreLifecycle : Script ()
testCoreLifecycle = script do
  network <- setupNetwork
  let p = network.parties

  invoiceCid <- approvedInvoice network "INV-001" [p.financierA, p.financierB]

  -- A rival is a stakeholder of the terms-free approval seal, but cannot query the
  -- private invoice details contract.
  Some approved <- queryContractId p.financierA invoiceCid
  None <- queryContractId p.financierA approved.invoiceDetails
  Some details <- queryContractId p.auditor approved.invoiceDetails
  assert (approved.invoiceCommitment
    == invoiceCommitmentFor p.supplier p.buyer details.terms details.salt)

  offerACid <- offerTo network invoiceCid p.financierA 80.0 0.80
  offerBCid <- offerTo network invoiceCid p.financierB 75.0 0.75

  Some _ <- queryContractId p.financierA offerACid
  None <- queryContractId p.financierB offerACid
  None <- queryContractId p.financierB approved.invoiceDetails

  (rulesCid, _) <- currentRules network
  financedCid <- submit (actAs [p.buyer, p.supplier, p.financierA]) do
    exerciseCmd offerACid Accept with
      approvedInvoiceCid = invoiceCid
      rulesCid
      paymentReference = "BANK-REF-001"

  Some _ <- queryContractId p.financierA financedCid
  Some _ <- queryContractId p.auditor financedCid
  -- The private details are archived once the invoice is funded.
  None <- queryContractId p.auditor approved.invoiceDetails
  [(_, receipt)] <- query @FundingReceipt p.auditor
  assert (receipt.settlementAmount == 80.0 && receipt.instrument == "OFF_LEDGER")

  -- B's offer is real, but the approved invoice and its one-use slot are gone. The
  -- failed submission is the load-bearing proof of single financing.
  submitMustFail (actAs [p.buyer, p.supplier, p.financierB]) do
    exerciseCmd offerBCid Accept with
      approvedInvoiceCid = invoiceCid
      rulesCid
      paymentReference = "BANK-REF-002"
  None <- queryContractId p.financierB approved.fundingSlot
  None <- queryContractId p.financierB financedCid

  -- Closing the losing offer leaves B a fact with no winner, amount or terms.
  closedCid <- submit p.supplier do exerciseCmd offerBCid Withdraw
  Some closed <- queryContractId p.financierB closedCid
  assert (closed.financier == p.financierB
    && closed.invoiceCommitment == approved.invoiceCommitment)
  None <- queryContractId p.financierB offerBCid
  [] <- query @FinancedInvoice p.financierB
  [] <- query @FundingReceipt p.financierB

  -- Early repayment is valid as long as it is not before issuance.
  receiptCid <- submit (actAs [p.buyer, p.financierA]) do
    exerciseCmd financedCid Repay with
      repaymentDate = date 2026 Jan 15
      paymentReference = "BANK-REPAY-001"
  Some repayment <- queryContractId p.auditor receiptCid
  assert (repayment.early && repayment.amount == 100.0)
  None <- queryContractId p.financierA financedCid

  pure ()

testSingleApproval : Script ()
testSingleApproval = script do
  network <- setupNetwork
  let p = network.parties
  _ <- approvedInvoice network "INV-DUP" [p.financierA]

  -- A second draft with the same external invoice number is refused by the buyer's
  -- operator-signed registry.
  duplicateDraftCid <- submit p.supplier do
    createCmd InvoiceDraft with
      supplier = p.supplier
      buyer = p.buyer
      terms = sampleTerms "INV-DUP"
      salt = "another-salt-0123456789"
  (rulesCid, _) <- currentRules network
  registryCid <- registryFor network
  submitMustFail p.buyer do
    exerciseCmd duplicateDraftCid Approve with
      rulesCid
      registryCid
      eligibleFinanciers = [p.financierA]
      auditor = p.auditor

  -- The buyer cannot mint a second registry on the real network: that needs every
  -- operator's signature.
  submitMustFail p.buyer do
    createCmd BuyerApprovalRegistry with
      networkId = "tavryn-test"
      operators = operatorsOf p
      buyer = p.buyer
      approvedInvoiceNumbers = []

  -- It can invent a network of its own and approve the duplicate there, with the
  -- supplier's help. That invoice still cannot be funded, because the financier
  -- funds only against the real network's rules.
  fakeRulesCid <- submit p.buyer do
    createCmd NetworkRules with
      networkId = "tavryn-test"
      operators = [p.buyer]
      threshold = 1
      financiers = [p.financierA]
      buyers = [p.buyer]
      participants = []
      maxAdvanceRate = 1.0
      version = 1
  fakeRegistryCid <- submit p.buyer do
    createCmd BuyerApprovalRegistry with
      networkId = "tavryn-test"
      operators = [p.buyer]
      buyer = p.buyer
      approvedInvoiceNumbers = []
  fakeApprovedCid <- submit p.buyer do
    exerciseCmd duplicateDraftCid Approve with
      rulesCid = fakeRulesCid
      registryCid = fakeRegistryCid
      eligibleFinanciers = [p.financierA]
      auditor = p.auditor
  fakeOfferCid <- submit (actAs [p.buyer, p.supplier]) do
    exerciseCmd fakeApprovedCid CreateOffer with
      rulesCid = fakeRulesCid
      financier = p.financierA
      advance = 50.0
      advanceRate = 0.50
      fee = None
  submitMustFail (actAs [p.buyer, p.supplier, p.financierA]) do
    exerciseCmd fakeOfferCid Accept with
      approvedInvoiceCid = fakeApprovedCid
      rulesCid
      paymentReference = "BANK-FAKE"

  -- A buyer can be onboarded only once, so there is only ever one registry.
  submitMustFail p.operatorOne do
    exerciseCmd network.committee Propose with
      proposer = p.operatorOne
      action = OnboardBuyer p.buyer
      rulesCid
      expiresAt = time (date 2030 Jan 1) 0 0 0
  _ <- registryFor network

  -- Only admitted financiers can be made eligible.
  draftCid <- submit p.supplier do
    createCmd InvoiceDraft with
      supplier = p.supplier
      buyer = p.buyer
      terms = sampleTerms "INV-NOT-MEMBER"
      salt = "salt-not-member-0123456789"
  registryCid <- registryFor network
  submitMustFail p.buyer do
    exerciseCmd draftCid Approve with
      rulesCid
      registryCid
      eligibleFinanciers = [p.financierC]
      auditor = p.auditor
  pure ()
